def _manager(
    backend: OllamaLocalModelBackend,
    settings: Settings,
) -> LocalModelManager:
    manager = LocalModelManager(
        backend=backend,
        resource_provider=FakeResourceProvider(),
        token_counter=FakeContextTokenCounter(),
        limits=LocalModelLimits.from_settings(settings),
    )
    manager.register(
        LocalModelDescriptor(
            model_id=OLLAMA_MANAGER_MODEL_ID,
            tasks=frozenset(
                {LocalModelTask.ANSWER_QUESTION, LocalModelTask.SUMMARIZE_TEXT}
            ),
            max_context_tokens=settings.local_max_context_tokens,
            requirements=ModelRequirements(ram_bytes=100, vram_bytes=50),
            catalog_entry_id="synthetic-test-entry",
            tokenizer_model_id=settings.local_ollama_model,
            tokenizer_id="fixture-tokenizer",
        )
    )
    return manager


def test_synthetic_catalog_verifier_cannot_enable_production_composition() -> None:
    settings = _settings()
    transport = FakeOllamaTransport(
        [_response({"model_info": {"general.architecture": "test"}})]
    )
    backend = _backend(transport, settings)
    manager = _manager(backend, settings)

    assert backend._model_catalog is not None
    assert backend._model_catalog.has_identity_verifier is True
    assert manager.is_production_ready is False
    with pytest.raises(ValueError, match="not verified for production"):
        create_application(settings, local_model_manager=manager)
    with pytest.raises(LocalModelResourceError):
        manager.run(
            task=LocalModelTask.ANSWER_QUESTION,
            content="synthetic test input",
        )
    assert transport.calls == []


