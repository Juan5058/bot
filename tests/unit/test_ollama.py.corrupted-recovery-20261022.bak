            ai_provider="local",
            local_max_context_tokens=128,
        ),
    ):
        with pytest.raises(ValueError):
            OllamaLocalModelBackend(settings=settings)


def test_standard_transport_disables_proxies_and_rejects_redirects(
    monkeypatch,
) -> None:
    import jarvis.ai.ollama as ollama_module

    class RedirectingOpener:
        def open(self, request, timeout):
            assert request.full_url == "http://127.0.0.1:11434/api/show"
            assert timeout == 2.0
            raise HTTPError(
                request.full_url,
                302,
                "redirect",
                {},
                BytesIO(b""),
            )

    def build_opener(*handlers):
        proxy_handler = next(
            handler for handler in handlers if isinstance(handler, ProxyHandler)
        )
        redirect_handler = next(
            handler for handler in handlers if isinstance(handler, _NoRedirectHandler)
        )
        assert proxy_handler.proxies == {}
        assert (
            redirect_handler.redirect_request(
                Request("http://127.0.0.1:11434/api/show"),
                BytesIO(),
                302,
                "redirect",
                {},
                "http://external.invalid/",
            )
            is None
        )
        return RedirectingOpener()

    monkeypatch.setattr(ollama_module, "build_opener", build_opener)
    response = _UrllibOllamaTransport().request(
        "POST",
        "http://127.0.0.1:11434/api/show",
        {"model": "gemma3:latest"},
        2.0,
    )

    assert response.status_code == 302
    assert response.body == b""


def test_transport_preparation_failure_is_classified_as_not_sent(monkeypatch) -> None:
    import jarvis.ai.ollama as ollama_module

    def fail_request(*args, **kwargs):
        del args, kwargs
        raise ValueError("PRIVATE_PREPARATION_FAILURE")

    def unexpected_build_opener(*args, **kwargs):
        del args, kwargs
        raise AssertionError("Transport opener must not be constructed.")

    monkeypatch.setattr(ollama_module, "Request", fail_request)
    monkeypatch.setattr(ollama_module, "build_opener", unexpected_build_opener)

    with pytest.raises(OllamaBackendError) as error:
        _UrllibOllamaTransport().request(
            "POST",
            "http://127.0.0.1:11434/api/generate",
            {"prompt": "PRIVATE_PROMPT_MARKER"},
            2.0,
        )

    assert error.value.classification is OllamaOperationClassification.NOT_SENT
    assert "PRIVATE_" not in str(error.value)


