def test_ollama_backend_rejects_runtime_identity_mismatch() -> None:
    settings = _settings()
    dependencies = _strict_backend_kwargs(settings)
    declared_catalog = dependencies["model_catalog"]
    entry = declared_catalog.entries[0]
    other_identity = ArtifactIdentity(
        runtime=entry.identity.runtime,
        artifact_id=entry.identity.artifact_id,
        variant="different-synthetic-variant",
        quantization=entry.identity.quantization,
        digest=entry.identity.digest,
    )
    dependencies["model_catalog"] = ModelCatalog(
        (entry,),
        identity_verifier=MatchingIdentityVerifier(other_identity),
    )
    transport = FakeOllamaTransport(
        [_response({"model_info": {"general.architecture": "test"}})]
    )
    ledger = _temporary_ledger(max_concurrent_operations=1)
    backend = OllamaLocalModelBackend(
        settings=settings,
        transport=transport,
        ledger=ledger,
        **dependencies,
    )

    with pytest.raises(OllamaBackendError, match="strictly verified"):
        backend.load(OLLAMA_MANAGER_MODEL_ID)

    assert [call[1].rsplit("/", 1)[-1] for call in transport.calls] == ["version"]
    assert ledger.records()[0].outcome is RemoteOperationOutcome.UNCERTAIN


def test_ollama_backend_rejects_denied_authorization_and_incompatible_runtime() -> None:
