    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError) as error:
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "PRIVATE_PROMPT_MARKER",
            context_tokens=8,
            max_context_tokens=128,
        )

    assert error.value.classification is OllamaOperationClassification.OUTCOME_UNKNOWN
    assert all(
        marker not in str(error.value)
        for marker in (
            "PRIVATE_TIMEOUT_MARKER",
            "PRIVATE_DISCONNECT_MARKER",
            "PRIVATE_PROMPT_MARKER",
        )
    )
    with pytest.raises(OllamaBackendError, match="uncertain"):
        backend.unload(handle)
    assert len(transport.calls) == 4


def test_response_body_read_failure_is_uncertain_and_sanitized(monkeypatch) -> None:
    import jarvis.ai.ollama as ollama_module

    class FailingBodyResponse:
        status = 200
        closed = False

        def read(self, limit: int) -> bytes:
            assert limit > 0
            raise OSError(
                "PRIVATE_BODY_READ_FAILURE PRIVATE_PARTIAL_RESPONSE "
                "PRIVATE_CREDENTIAL_MARKER"
            )

        def close(self) -> None:
            self.closed = True

    response = FailingBodyResponse()
    opener_calls = 0

    class Opener:
        def open(self, request, timeout):
            nonlocal opener_calls
            opener_calls += 1
            assert request.full_url.endswith("/api/generate")
            return response

    monkeypatch.setattr(ollama_module, "build_opener", lambda *args: Opener())

    class ResponseReadFailureTransport:
        def __init__(self) -> None:
            self.calls = 0
            self.transport = _UrllibOllamaTransport()

        def request(
            self,
            method: str,
            url: str,
            payload: dict[str, object] | None,
            timeout_seconds: float,
        ) -> OllamaHTTPResponse:
            self.calls += 1
            if url.endswith("/api/version"):
                return _response({"version": "0.5.4"})
            if url.endswith("/api/show"):
                return _response(
                    {"model_info": {"general.architecture": "test"}}
                )
            return self.transport.request(
                method,
                url,
                payload,
                timeout_seconds,
            )

    transport = ResponseReadFailureTransport()
    ledger = _temporary_ledger(max_concurrent_operations=1)
    backend = _backend(transport, ledger=ledger)
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError) as error:
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "PRIVATE_PROMPT_MARKER",
            context_tokens=8,
            max_context_tokens=128,
        )

    assert error.value.classification is OllamaOperationClassification.OUTCOME_UNKNOWN
    assert all(
        marker not in str(error.value)
        for marker in (
            "PRIVATE_BODY_READ_FAILURE",
            "PRIVATE_PARTIAL_RESPONSE",
            "PRIVATE_CREDENTIAL_MARKER",
            "PRIVATE_PROMPT_MARKER",
        )
    )
    assert response.closed
    assert opener_calls == 1
    assert transport.calls == 4
    with pytest.raises(OllamaBackendError, match="uncertain"):
        backend.unload(handle)
    assert transport.calls == 4
    assert any(
        record.operation_type.value == "infer"
        and record.outcome is RemoteOperationOutcome.UNCERTAIN
        for record in ledger.records()
    )


@pytest.mark.parametrize(
    ("response", "classification"),
    (
        (
            _response(
                {
                    "error": "PRIVATE_SERVER_ERROR",
                    "response": "PRIVATE_PARTIAL",
                    "authorization": "PRIVATE_CREDENTIAL_MARKER",
                },
                status_code=500,
            ),
            OllamaOperationClassification.HTTP_RESPONSE_RECEIVED,
        ),
        (
            OllamaHTTPResponse(
                200,
                b'{"done": true, "response": "PRIVATE_SERVER_CONTENT"',
            ),
            OllamaOperationClassification.RESPONSE_INVALID,
        ),
    ),
)
def test_http_error_and_invalid_json_are_classified_without_leaking_content(
    response: OllamaHTTPResponse,
    classification: OllamaOperationClassification,
) -> None:
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            response,
        ]
    )
    backend = _backend(transport)
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError) as error:
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "PRIVATE_PROMPT",
            context_tokens=8,
            max_context_tokens=128,
        )

    assert error.value.classification is classification
    assert all(
        marker not in str(error.value)
        for marker in (
            "PRIVATE_SERVER_ERROR",
            "PRIVATE_SERVER_CONTENT",
            "PRIVATE_PARTIAL",
            "PRIVATE_CREDENTIAL_MARKER",
            "PRIVATE_PROMPT",
        )
    )
    with pytest.raises(OllamaBackendError, match="uncertain"):
        backend.unload(handle)
    assert len(transport.calls) == 4


@pytest.mark.parametrize(
    "generation",
    (
        {"done": False, "response": "PRIVATE_PARTIAL_RESPONSE"},
        {"done": True},
        {"done": True, "response": ""},
        {"done": True, "response": "PRIVATE_INVALID_RESPONSE_MARKER\x00"},
    ),
)
def test_incomplete_or_invalid_generation_is_classified_and_sanitized(
    generation: dict[str, object],
) -> None:
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            _response(generation),
            _response({"models": []}),
        ]
    )
    backend = _backend(transport)
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError) as error:
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "PRIVATE_PROMPT_MARKER",
            context_tokens=8,
            max_context_tokens=128,
        )

    expected_classification = (
        OllamaOperationClassification.OUTCOME_UNKNOWN
        if generation["done"] is not True
        else OllamaOperationClassification.TERMINAL_RESPONSE_INVALID
    )
    assert error.value.classification is expected_classification
    assert "PRIVATE_PROMPT_MARKER" not in str(error.value)
    assert "PRIVATE_PARTIAL_RESPONSE" not in str(error.value)
    assert "PRIVATE_INVALID_RESPONSE_MARKER" not in str(error.value)

    if generation["done"] is True:
        backend.unload(handle)
        assert len(transport.calls) == 5
    else:
        with pytest.raises(OllamaBackendError, match="uncertain"):
            backend.unload(handle)
        assert len(transport.calls) == 4


def test_unload_http_error_is_received_but_not_treated_as_confirmed_unload() -> None:
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            _response({"models": [{"name": "gemma3:latest"}]}),
            _response(
                {
                    "error": "PRIVATE_UNLOAD_SERVER_ERROR",
                    "authorization": "PRIVATE_CREDENTIAL_MARKER",
                },
                status_code=500,
            ),
        ]
    )
    backend = _backend(transport)
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError) as error:
        backend.unload(handle)

    assert error.value.classification is (
        OllamaOperationClassification.HTTP_RESPONSE_RECEIVED
    )
    assert "PRIVATE_UNLOAD_SERVER_ERROR" not in str(error.value)
    assert "PRIVATE_CREDENTIAL_MARKER" not in str(error.value)
    assert len(transport.calls) == 4
    with pytest.raises(OllamaBackendError, match="uncertain"):
        backend.unload(handle)


def test_valid_terminal_generation_is_classified_as_terminal_and_valid() -> None:
    classification, text = OllamaLocalModelBackend._generation_text(
        {"done": True, "response": "Respuesta final."},
        allow_empty=False,
    )

    assert classification is (
        OllamaOperationClassification.TERMINAL_RESPONSE_VALIDATED
    )
    assert text == "Respuesta final."


def test_ollama_backend_rejects_invalid_context_before_http_request() -> None:
    transport = FakeOllamaTransport(
        [_response({"model_info": {"general.architecture": "test"}})]
    )
    backend = _backend(transport)
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError, match="context"):
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "Pregunta",
            context_tokens=129,
            max_context_tokens=128,
        )

    assert len(transport.calls) == 2


def test_completed_but_invalid_generation_can_still_be_unloaded() -> None:
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            _response({"done": True, "response": ""}),
            _response({"models": [{"name": "gemma3:latest"}]}),
            _response({"done": True, "response": ""}),
            _response({"models": []}),
        ]
    )
    backend = _backend(transport)
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError):
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "Pregunta",
            context_tokens=8,
            max_context_tokens=128,
        )
    backend.unload(handle)

    assert len(transport.calls) == 7


def test_backend_revalidates_mutated_settings_before_use() -> None:
    settings = _settings()
    settings.local_ollama_base_url = "http://example.test"

    with pytest.raises(ValidationError):
        OllamaLocalModelBackend(settings=settings)


def test_application_rejects_incomplete_ollama_manager_before_any_request() -> None:
    settings = _settings()
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}})
        ]
    )
    manager = _manager(_backend(transport, settings), settings)
    with pytest.raises(ValueError, match="not verified for production"):
        create_application(settings, local_model_manager=manager)
    assert transport.calls == []


def test_local_mode_without_production_manager_has_no_remote_fallback() -> None:
    settings = _settings()
    app = create_application(settings)
    calls = {"remote": 0}

    class RemoteSpy(SimulatedAIProvider):
        def respond_informational(self, request: InformationalRequest):
            del request
            calls["remote"] += 1
            raise AssertionError("Local provider absence invoked remote AI.")

    app.provider_selector = AIProviderSelector({"remote": RemoteSpy()})
    result = app.process("pregunta: ¿qué significa?")

    assert result.success is False
    assert result.authorized is False
    assert result.error == "Informative processing is unavailable."
    assert calls == {"remote": 0}
