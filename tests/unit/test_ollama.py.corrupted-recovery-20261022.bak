_temporary_ledger_directories: list[tempfile.TemporaryDirectory[str]] = []
_temporary_ledgers: list[RemoteOperationLedger] = []


@pytest.fixture(scope="module", autouse=True)
def _close_temporary_ledgers():
    yield
    for ledger in _temporary_ledgers:
        ledger.close()
    for directory in _temporary_ledger_directories:
        directory.cleanup()


def _temporary_ledger(max_concurrent_operations: int) -> RemoteOperationLedger:
    directory = tempfile.TemporaryDirectory(prefix="jarvis-ledger-tests-")
    _temporary_ledger_directories.append(directory)
    ledger = RemoteOperationLedger(
        max_concurrent_operations=max_concurrent_operations,
        sqlite_path=Path(directory.name) / "remote-operations.sqlite3",
    )
    _temporary_ledgers.append(ledger)
    return ledger


class FakeOllamaTransport:
    def __init__(
        self,
        responses: list[OllamaHTTPResponse | BaseException],
        *,
        runtime_version: str = "0.5.4",
    ) -> None:
        self.responses = list(responses)
        self.runtime_version = runtime_version
        self.calls: list[tuple[str, str, dict[str, object] | None, float]] = []

    def request(
        self,
        method: str,
        url: str,
        payload: dict[str, object] | None,
        timeout_seconds: float,
    ) -> OllamaHTTPResponse:
        self.calls.append((method, url, payload, timeout_seconds))
        if url.endswith("/api/version"):
            return _response({"version": self.runtime_version})
        if not self.responses:
            raise AssertionError("Unexpected Ollama HTTP request.")
        response = self.responses.pop(0)
        if isinstance(response, BaseException):
            raise response
        return response


class FakeResourceProvider:
    def snapshot(self) -> ResourceSnapshot:
        return ResourceSnapshot(
            source=ResourceSource.INFERENCE_BACKEND,
            available_ram_bytes=1_000_000,
            available_vram_bytes=1_000_000,
            total_ram_bytes=2_000_000,
        )


class FakeContextTokenCounter:
    tokenizer_id = "fixture-tokenizer"

    def count_tokens(
        self,
        model_id: str,
        task: LocalModelTask,
        content: str,
    ) -> int:
        del model_id, task
        return len(content.split())


class _SyntheticTestOllamaBackend(OllamaLocalModelBackend):
    def _require_authenticated_artifact_identity(self) -> None:
        return None


class MatchingIdentityVerifier:
    def __init__(self, observed: ArtifactIdentity) -> None:
        self.observed = observed

    def verify(self, declared_identity: ArtifactIdentity) -> ArtifactIdentity:
        del declared_identity
        return self.observed


class AllowOllamaUse:
    def authorize(self, model, task) -> bool:
        del model, task
        return True


class DenyOllamaUse:
    def authorize(self, model, task) -> bool:
        del model, task
        return False


class ChangingIdentityVerifier:
    def __init__(
        self,
        first: ArtifactIdentity,
        later: ArtifactIdentity,
    ) -> None:
        self.first = first
        self.later = later
        self.calls = 0

    def verify(self, declared_identity: ArtifactIdentity) -> ArtifactIdentity:
        del declared_identity
        self.calls += 1
        return self.first if self.calls == 1 else self.later


def _synthetic_model_catalog(settings: Settings) -> ModelCatalog:
    model_name = settings.local_ollama_model
    assert type(model_name) is str
    identity = ArtifactIdentity(
        runtime=ModelRuntime.OLLAMA,
        artifact_id=model_name,
        variant="synthetic-test-variant",
        quantization="synthetic-test-quantization",
        digest="sha256:" + "a" * 64,
    )
    entry = ModelCatalogEntry(
        entry_id="synthetic-test-entry",
        identity=identity,
        compatibility=RuntimeCompatibility(
            ModelRuntime.OLLAMA,
            "0.5.0",
            "0.5.9",
        ),
        requirements=(
            ResourceRequirement(
                ResourceKind.RAM,
                100,
                RequirementBasis.CONSERVATIVE_BOUND,
                "synthetic unit-test fixture",
                "fixed test value",
                "not a real model requirement",
            ),
            ResourceRequirement(
                ResourceKind.VRAM,
                50,
                RequirementBasis.CONSERVATIVE_BOUND,
                "synthetic unit-test fixture",
                "fixed test value",
                "not a real model requirement",
            ),
        ),
        required_resources=frozenset({ResourceKind.RAM, ResourceKind.VRAM}),
        max_context_tokens=settings.local_max_context_tokens,
        tokenizer_id="fixture-tokenizer",
    )
    return ModelCatalog(
        (entry,),
        identity_verifier=MatchingIdentityVerifier(identity),
    )


def _response(
    data: object,
    *,
    status_code: int = 200,
) -> OllamaHTTPResponse:
    return OllamaHTTPResponse(
        status_code=status_code,
        body=json.dumps(data).encode("utf-8"),
    )


def _settings(**overrides: object) -> Settings:
    values: dict[str, object] = {
        "ai_enabled": True,
        "ai_provider": "local",
        "local_max_context_tokens": 128,
        "local_ram_budget_mb": 1,
        "local_vram_budget_mb": 1,
        "local_ollama_model": "gemma3:latest",
    }
    values.update(overrides)
    return Settings(**values)


def _backend(
    transport: FakeOllamaTransport,
    settings: Settings | None = None,
    ledger: RemoteOperationLedger | None = None,
) -> OllamaLocalModelBackend:
    selected_settings = settings or _settings()
    return _SyntheticTestOllamaBackend(
        settings=selected_settings,
        transport=transport,
        ledger=ledger
        or _temporary_ledger(
            max_concurrent_operations=selected_settings.local_max_concurrent_inferences
        ),
        **_strict_backend_kwargs(selected_settings),
    )


def _strict_backend_kwargs(settings: Settings) -> dict[str, object]:
    return {
        "model_catalog": _synthetic_model_catalog(settings),
        "catalog_entry_id": "synthetic-test-entry",
        "model_use_authorizer": AllowOllamaUse(),
        "token_counter": FakeContextTokenCounter(),
    }


def test_operation_is_persisted_before_transport_invocation(tmp_path) -> None:
    database = tmp_path / "remote-operations.sqlite3"
    ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )

    class ObservingTransport:
        def request(
            self,
            method: str,
            url: str,
            payload: dict[str, object] | None,
            timeout_seconds: float,
        ) -> OllamaHTTPResponse:
            del method, timeout_seconds
            with sqlite3.connect(database) as connection:
                row = connection.execute(
                    "SELECT outcome, operation_type FROM remote_operations"
                ).fetchone()
            assert row == ("pending", "inspect")
            if url.endswith("/api/version"):
                return _response({"version": "0.5.4"})
            assert url.endswith("/api/show")
            assert payload is not None
            assert "operation_id" not in payload
            return _response({"model_info": {"general.architecture": "test"}})

    backend = _backend(ObservingTransport(), ledger=ledger)
    backend.load(OLLAMA_MANAGER_MODEL_ID)

    records = ledger.records()
    assert len(records) == 1
    assert records[0].outcome is RemoteOperationOutcome.TERMINAL_VALID
    assert ledger.active_operation_count == 0
    ledger.close()


def test_backend_storage_failure_prevents_transport_send(tmp_path) -> None:
    database = tmp_path / "remote-operations.sqlite3"
    ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )
    connection = sqlite3.connect(database)
    connection.execute(
        "CREATE TRIGGER reject_dispatch BEFORE UPDATE ON remote_operations "
        "WHEN NEW.outcome = 'pending' BEGIN "
        "SELECT RAISE(ABORT, 'PRIVATE_SQLITE_FAILURE'); END"
    )
    connection.commit()
    connection.close()
    transport = FakeOllamaTransport([])
    backend = _backend(transport, ledger=ledger)

    with pytest.raises(OllamaBackendError) as error:
        backend.load(OLLAMA_MANAGER_MODEL_ID)

    assert "PRIVATE_SQLITE_FAILURE" not in str(error.value)
    assert transport.calls == []
    assert ledger.active_operation_count == 1
    assert ledger.records()[0].outcome is RemoteOperationOutcome.RESERVED
    ledger.close()


def test_backend_does_not_return_result_when_terminal_commit_fails(tmp_path) -> None:
    database = tmp_path / "remote-operations.sqlite3"
    ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )
    connection = sqlite3.connect(database)
    connection.execute(
        "CREATE TRIGGER reject_terminal BEFORE UPDATE ON remote_operations "
        "WHEN NEW.outcome = 'terminal_valid' BEGIN "
        "SELECT RAISE(ABORT, 'PRIVATE_SQLITE_FAILURE'); END"
    )
    connection.commit()
    connection.close()
    transport = FakeOllamaTransport(
        [_response({"model_info": {"general.architecture": "test"}})]
    )
    backend = _backend(transport, ledger=ledger)

    with pytest.raises(OllamaBackendError) as error:
        backend.load(OLLAMA_MANAGER_MODEL_ID)

    assert "PRIVATE_SQLITE_FAILURE" not in str(error.value)
    assert len(transport.calls) == 2
    assert ledger.records()[0].outcome is RemoteOperationOutcome.UNCERTAIN
    assert ledger.active_operation_count == 1
    ledger.close()


def test_backend_enforces_capacity_across_sqlite_connections(tmp_path) -> None:
    database = tmp_path / "remote-operations.sqlite3"
    first_ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )
    second_ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )
    request_started = Event()
    release_request = Event()
    first_errors: list[BaseException] = []

    class BlockingTransport:
        def request(
            self,
            method: str,
            url: str,
            payload: dict[str, object] | None,
            timeout_seconds: float,
        ) -> OllamaHTTPResponse:
            del method, payload, timeout_seconds
            if url.endswith("/api/version"):
                return _response({"version": "0.5.4"})
            request_started.set()
            if not release_request.wait(timeout=3):
                raise TimeoutError("test transport release expired")
            return _response({"model_info": {"general.architecture": "test"}})

    first_transport = BlockingTransport()
    second_transport = FakeOllamaTransport(
        [_response({"model_info": {"general.architecture": "test"}})]
    )
    first_backend = _backend(first_transport, ledger=first_ledger)
    second_backend = _backend(second_transport, ledger=second_ledger)

    def first_load() -> None:
        try:
            first_backend.load(OLLAMA_MANAGER_MODEL_ID)
        except BaseException as error:
            first_errors.append(error)

    worker = Thread(target=first_load)
    worker.start()
    try:
        assert request_started.wait(timeout=3)
        with pytest.raises(OllamaBackendError, match="capacity"):
            second_backend.load(OLLAMA_MANAGER_MODEL_ID)
        assert second_transport.calls == []
    finally:
        release_request.set()
        worker.join(timeout=3)
    assert not worker.is_alive()
    assert first_errors == []
    first_ledger.close()
    second_ledger.close()


def test_pre_dispatch_failure_releases_only_its_ledger_record(
    monkeypatch,
    tmp_path,
) -> None:
    import jarvis.ai.ollama as ollama_module

    database = tmp_path / "remote-operations.sqlite3"
    ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )

    def fail_request_construction(*args, **kwargs):
        del args, kwargs
        raise ValueError("PRIVATE_PREPARATION_MARKER")

    monkeypatch.setattr(ollama_module, "Request", fail_request_construction)
    backend = _backend(_UrllibOllamaTransport(), ledger=ledger)

    with pytest.raises(OllamaBackendError) as error:
        backend.load(OLLAMA_MANAGER_MODEL_ID)

    record = ledger.records()[0]
    assert error.value.classification is OllamaOperationClassification.NOT_SENT
    assert record.outcome is RemoteOperationOutcome.NOT_SENT
    assert ledger.active_operation_count == 0
    assert "PRIVATE_PREPARATION_MARKER" not in str(error.value)
    ledger.close()


def test_default_backend_uses_only_local_app_data_for_persistent_ledger(
    monkeypatch,
    tmp_path,
) -> None:
    local_app_data = tmp_path / "user-local-app-data"
    local_app_data.mkdir()
    monkeypatch.setenv("LOCALAPPDATA", str(local_app_data))
    transport = FakeOllamaTransport(
        [_response({"model_info": {"general.architecture": "test"}})]
    )
    settings = _settings()
    backend = _SyntheticTestOllamaBackend(
        settings=settings,
        transport=transport,
        **_strict_backend_kwargs(settings),
    )

    backend.load(OLLAMA_MANAGER_MODEL_ID)

    database = (
        local_app_data
        / "JARVIS"
        / "remote-operations.sqlite3"
    )
    assert database.is_file()
    assert backend._ledger.total_record_count == 1
    backend._ledger.close()


def test_persistent_ledger_does_not_store_prompts_responses_or_credentials(
    tmp_path,
) -> None:
    database = tmp_path / "remote-operations.sqlite3"
    ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            _response(
                {
                    "done": True,
                    "response": "PRIVATE_RESPONSE_MARKER",
                    "credential": "PRIVATE_CREDENTIAL_MARKER",
                }
            ),
        ]
    )
    backend = _backend(transport, ledger=ledger)
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    assert (
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "PRIVATE_PROMPT_MARKER",
            context_tokens=8,
            max_context_tokens=128,
        )
        == "PRIVATE_RESPONSE_MARKER"
    )
    ledger.close()

    stored_bytes = database.read_bytes()
    for marker in (
        b"PRIVATE_PROMPT_MARKER",
        b"PRIVATE_RESPONSE_MARKER",
        b"PRIVATE_CREDENTIAL_MARKER",
    ):
        assert marker not in stored_bytes


def test_uncertain_operation_survives_restart_and_blocks_new_inference(
    tmp_path,
) -> None:
    database = tmp_path / "remote-operations.sqlite3"
    settings = _settings(local_max_concurrent_inferences=2)
    first_ledger = RemoteOperationLedger(
        max_concurrent_operations=2,
        sqlite_path=database,
    )
    first_transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            TimeoutError("PRIVATE_TIMEOUT_MARKER"),
        ]
    )
    first_backend = _backend(first_transport, settings, first_ledger)
    handle = first_backend.load(OLLAMA_MANAGER_MODEL_ID)
    with pytest.raises(OllamaBackendError):
        first_backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "PRIVATE_PROMPT_MARKER",
            context_tokens=8,
            max_context_tokens=128,
        )
    uncertain_records = tuple(
        record
        for record in first_ledger.records()
        if record.outcome is RemoteOperationOutcome.UNCERTAIN
    )
    assert len(uncertain_records) == 1
    first_ledger.close()

    restarted_ledger = RemoteOperationLedger(
        max_concurrent_operations=2,
        sqlite_path=database,
    )
    second_transport = FakeOllamaTransport([])
    restarted_backend = _backend(second_transport, settings, restarted_ledger)

    with pytest.raises(OllamaBackendError) as error:
        restarted_backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "PRIVATE_PROMPT_MARKER",
            context_tokens=8,
            max_context_tokens=128,
        )

    assert error.value.classification is (
        OllamaOperationClassification.OUTCOME_UNKNOWN
    )
    assert second_transport.calls == []
    assert restarted_ledger.get(uncertain_records[0].operation_id).outcome is (
        RemoteOperationOutcome.UNCERTAIN
    )
    assert restarted_ledger.active_operation_count == 1
    restarted_ledger.close()


@pytest.mark.parametrize(
    ("generation", "expected_outcome", "expected_active"),
    (
        (
            {"done": True, "response": "private output"},
            RemoteOperationOutcome.TERMINAL_VALID,
            0,
        ),
        (
            {"done": True, "response": ""},
            RemoteOperationOutcome.TERMINAL_INVALID,
            0,
        ),
        (
            {"done": False, "response": "PRIVATE_PARTIAL_RESPONSE"},
            RemoteOperationOutcome.UNCERTAIN,
            1,
        ),
    ),
)
def test_inference_result_transitions_only_its_correlated_ledger_record(
    generation: dict[str, object],
    expected_outcome: RemoteOperationOutcome,
    expected_active: int,
) -> None:
    ledger = _temporary_ledger(max_concurrent_operations=2)
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            _response(generation),
        ]
    )
    backend = _backend(
        transport,
        settings=_settings(local_max_concurrent_inferences=2),
        ledger=ledger,
    )
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    if expected_outcome is RemoteOperationOutcome.TERMINAL_VALID:
        assert (
            backend.infer(
                handle,
                LocalModelTask.ANSWER_QUESTION,
                "PRIVATE_PROMPT_MARKER",
                context_tokens=8,
                max_context_tokens=128,
            )
            == "private output"
        )
    else:
        with pytest.raises(OllamaBackendError):
            backend.infer(
                handle,
                LocalModelTask.ANSWER_QUESTION,
                "PRIVATE_PROMPT_MARKER",
                context_tokens=8,
                max_context_tokens=128,
            )

    records = ledger.records()
    infer_records = [
        record
        for record in records
        if record.operation_type.value == "infer"
    ]
    assert len(infer_records) == 1
    assert infer_records[0].outcome is expected_outcome
    assert ledger.active_operation_count == expected_active
    assert "PRIVATE_PROMPT_MARKER" not in repr(infer_records[0])
    assert "PRIVATE_PARTIAL_RESPONSE" not in repr(infer_records[0])


@pytest.mark.parametrize(
    ("generation_response", "expected_outcome", "expected_active"),
    (
        (
            _response({"error": "PRIVATE_HTTP_ERROR"}, status_code=500),
            RemoteOperationOutcome.UNCERTAIN,
            1,
        ),
        (
            OllamaHTTPResponse(200, b"{PRIVATE_MALFORMED_JSON"),
            RemoteOperationOutcome.UNCERTAIN,
            1,
        ),
        (
            _response({"done": False, "response": "PRIVATE_PARTIAL"}),
            RemoteOperationOutcome.UNCERTAIN,
            1,
        ),
        (
            _response({"done": True, "response": ""}),
            RemoteOperationOutcome.TERMINAL_INVALID,
            0,
        ),
    ),
)
def test_ambiguous_and_terminal_invalid_responses_map_to_safe_ledger_states(
    generation_response: OllamaHTTPResponse,
    expected_outcome: RemoteOperationOutcome,
    expected_active: int,
) -> None:
    ledger = _temporary_ledger(max_concurrent_operations=1)
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            generation_response,
        ]
    )
    backend = _backend(transport, ledger=ledger)
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError) as error:
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "PRIVATE_PROMPT_MARKER",
            context_tokens=8,
            max_context_tokens=128,
        )

    infer_record = next(
        record
        for record in ledger.records()
        if record.operation_type.value == "infer"
    )
    assert infer_record.outcome is expected_outcome
    assert ledger.active_operation_count == expected_active
    assert "PRIVATE_PROMPT_MARKER" not in str(error.value)
    assert "PRIVATE_HTTP_ERROR" not in str(error.value)
    assert "PRIVATE_PARTIAL" not in str(error.value)


@pytest.mark.parametrize(
    "failure_position",
    ("status", "unload", "verify"),
)
def test_unload_keeps_one_slot_on_ambiguous_failure_in_any_http_phase(
    failure_position: str,
) -> None:
    responses: list[OllamaHTTPResponse | BaseException] = [
        _response({"model_info": {"general.architecture": "test"}})
    ]
    if failure_position == "status":
        responses.append(TimeoutError("PRIVATE_STATUS_TIMEOUT"))
    else:
        responses.append(_response({"models": [{"name": "gemma3:latest"}]}))
        if failure_position == "unload":
            responses.append(TimeoutError("PRIVATE_UNLOAD_TIMEOUT"))
        else:
            responses.extend(
                (
                    _response({"done": True, "response": ""}),
                    TimeoutError("PRIVATE_VERIFY_TIMEOUT"),
                )
            )
    ledger = _temporary_ledger(max_concurrent_operations=1)
    transport = FakeOllamaTransport(responses)
    backend = _backend(transport, ledger=ledger)
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError) as error:
        backend.unload(handle)

    unload_record = next(
        record
        for record in ledger.records()
        if record.operation_type.value == "unload"
    )
    assert error.value.classification is OllamaOperationClassification.OUTCOME_UNKNOWN
    assert unload_record.outcome is RemoteOperationOutcome.UNCERTAIN
    assert ledger.active_operation_count == 1
    assert len(transport.calls) == {
        "status": 3,
        "unload": 4,
        "verify": 5,
    }[failure_position]
    assert all(
        marker not in str(error.value)
        for marker in (
            "PRIVATE_STATUS_TIMEOUT",
            "PRIVATE_UNLOAD_TIMEOUT",
            "PRIVATE_VERIFY_TIMEOUT",
        )
    )


@pytest.mark.parametrize(
    "invalid_generation",
    (
        {"done": True},
        {"done": True, "response": ["invalid"]},
    ),
)
def test_unload_terminal_invalid_response_stays_uncertain_and_stops_flow(
    invalid_generation: dict[str, object],
) -> None:
    ledger = _temporary_ledger(max_concurrent_operations=2)
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            _response({"models": [{"name": "gemma3:latest"}]}),
            _response(invalid_generation),
        ]
    )
    backend = _backend(
        transport,
        settings=_settings(local_max_concurrent_inferences=2),
        ledger=ledger,
    )
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError) as error:
        backend.unload(handle)

    unload_record = next(
        record
        for record in ledger.records()
        if record.operation_type.value == "unload"
    )
    assert error.value.classification is (
        OllamaOperationClassification.TERMINAL_RESPONSE_INVALID
    )
    assert unload_record.outcome is RemoteOperationOutcome.UNCERTAIN
    assert ledger.active_operation_count == 1
    assert len(transport.calls) == 4

    with pytest.raises(OllamaBackendError):
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "PRIVATE_PROMPT_MARKER",
            context_tokens=8,
            max_context_tokens=128,
        )
    assert len(transport.calls) == 4
    assert ledger.get(unload_record.operation_id).outcome is (
        RemoteOperationOutcome.UNCERTAIN
    )


def test_uncertain_record_blocks_later_inspection_without_clearing_it() -> None:
    ledger = _temporary_ledger(max_concurrent_operations=2)
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            TimeoutError("PRIVATE_TIMEOUT"),
            _response({"model_info": {"general.architecture": "test"}}),
        ]
    )
    backend = _backend(
        transport,
        settings=_settings(local_max_concurrent_inferences=2),
        ledger=ledger,
    )
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)
    with pytest.raises(OllamaBackendError):
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "PRIVATE_PROMPT",
            context_tokens=8,
            max_context_tokens=128,
        )
    uncertain = next(
        record
        for record in ledger.records()
        if record.outcome is RemoteOperationOutcome.UNCERTAIN
    )

    calls_before_inspection = len(transport.calls)
    with pytest.raises(OllamaBackendError) as error:
        backend.load(OLLAMA_MANAGER_MODEL_ID)

    assert error.value.classification is OllamaOperationClassification.OUTCOME_UNKNOWN
    assert len(transport.calls) == calls_before_inspection
    assert ledger.get(uncertain.operation_id) == uncertain
    assert ledger.get(uncertain.operation_id).outcome is (
        RemoteOperationOutcome.UNCERTAIN
    )
    assert ledger.active_operation_count == 1


def test_ollama_backend_without_verifier_is_blocked_before_transport() -> None:
    settings = _settings()
    dependencies = _strict_backend_kwargs(settings)
    entry = dependencies["model_catalog"].entries[0]
    dependencies["model_catalog"] = ModelCatalog((entry,))
    transport = FakeOllamaTransport([])
    backend = _SyntheticTestOllamaBackend(
        settings=settings,
        transport=transport,
        ledger=_temporary_ledger(max_concurrent_operations=1),
        **dependencies,
    )

    with pytest.raises(OllamaBackendError, match="verification and authorization"):
        backend.load(OLLAMA_MANAGER_MODEL_ID)

    assert transport.calls == []


[str, str, dict[str, object] | None, float]] = []

    def request(
        self,
        method: str,
        url: str,
        payload: dict[str, object] | None,
        timeout_seconds: float,
    ) -> OllamaHTTPResponse:
        self.calls.append((method, url, payload, timeout_seconds))
        if url.endswith("/api/version"):
            return _response({"version": self.runtime_version})
        if not self.responses:
            raise AssertionError("Unexpected Ollama HTTP request.")
        response = self.responses.pop(0)
        if isinstance(response, BaseException):
            raise response
        return response


class FakeResourceProvider:
    def snapshot(self) -> ResourceSnapshot:
        return ResourceSnapshot(
            source=ResourceSource.INFERENCE_BACKEND,
            available_ram_bytes=1_000_000,
            available_vram_bytes=1_000_000,
            total_ram_bytes=2_000_000,
        )


class FakeContextTokenCounter:
    tokenizer_id = "fixture-tokenizer"

    def count_tokens(
        self,
        model_id: str,
        task: LocalModelTask,
        content: str,
    ) -> int:
        del model_id, task
        return len(content.split())


class _SyntheticTestOllamaBackend(OllamaLocalModelBackend):
    def _require_authenticated_artifact_identity(self) -> None:
        return None


class MatchingIdentityVerifier:
    def __init__(self, observed: ArtifactIdentity) -> None:
        self.observed = observed

    def verify(self, declared_identity: ArtifactIdentity) -> ArtifactIdentity:
        del declared_identity
        return self.observed


class AllowOllamaUse:
    def authorize(self, model, task) -> bool:
        del model, task
        return True


class DenyOllamaUse:
    def authorize(self, model, task) -> bool:
        del model, task
        return False


class ChangingIdentityVerifier:
    def __init__(
        self,
        first: ArtifactIdentity,
        later: ArtifactIdentity,
    ) -> None:
        self.first = first
        self.later = later
        self.calls = 0

    def verify(self, declared_identity: ArtifactIdentity) -> ArtifactIdentity:
        del declared_identity
        self.calls += 1
        return self.first if self.calls == 1 else self.later


def _synthetic_model_catalog(settings: Settings) -> ModelCatalog:
    model_name = settings.local_ollama_model
    assert type(model_name) is str
    identity = ArtifactIdentity(
        runtime=ModelRuntime.OLLAMA,
        artifact_id=model_name,
        variant="synthetic-test-variant",
        quantization="synthetic-test-quantization",
        digest="sha256:" + "a" * 64,
    )
    entry = ModelCatalogEntry(
        entry_id="synthetic-test-entry",
        identity=identity,
        compatibility=RuntimeCompatibility(
            ModelRuntime.OLLAMA,
            "0.5.0",
            "0.5.9",
        ),
        requirements=(
            ResourceRequirement(
                ResourceKind.RAM,
                100,
                RequirementBasis.CONSERVATIVE_BOUND,
                "synthetic unit-test fixture",
                "fixed test value",
                "not a real model requirement",
            ),
            ResourceRequirement(
                ResourceKind.VRAM,
                50,
                RequirementBasis.CONSERVATIVE_BOUND,
                "synthetic unit-test fixture",
                "fixed test value",
                "not a real model requirement",
            ),
        ),
        required_resources=frozenset({ResourceKind.RAM, ResourceKind.VRAM}),
        max_context_tokens=settings.local_max_context_tokens,
        tokenizer_id="fixture-tokenizer",
    )
    return ModelCatalog(
        (entry,),
        identity_verifier=MatchingIdentityVerifier(identity),
    )


def _response(
    data: object,
    *,
    status_code: int = 200,
) -> OllamaHTTPResponse:
    return OllamaHTTPResponse(
        status_code=status_code,
        body=json.dumps(data).encode("utf-8"),
    )


def _settings(**overrides: object) -> Settings:
    values: dict[str, object] = {
        "ai_enabled": True,
        "ai_provider": "local",
        "local_max_context_tokens": 128,
        "local_ram_budget_mb": 1,
        "local_vram_budget_mb": 1,
        "local_ollama_model": "gemma3:latest",
    }
    values.update(overrides)
    return Settings(**values)


def _backend(
    transport: FakeOllamaTransport,
    settings: Settings | None = None,
    ledger: RemoteOperationLedger | None = None,
) -> OllamaLocalModelBackend:
    selected_settings = settings or _settings()
    return _SyntheticTestOllamaBackend(
        settings=selected_settings,
        transport=transport,
        ledger=ledger
        or _temporary_ledger(
            max_concurrent_operations=selected_settings.local_max_concurrent_inferences
        ),
        **_strict_backend_kwargs(selected_settings),
    )


def _strict_backend_kwargs(settings: Settings) -> dict[str, object]:
    return {
        "model_catalog": _synthetic_model_catalog(settings),
        "catalog_entry_id": "synthetic-test-entry",
        "model_use_authorizer": AllowOllamaUse(),
        "token_counter": FakeContextTokenCounter(),
    }


def test_operation_is_persisted_before_transport_invocation(tmp_path) -> None:
    database = tmp_path / "remote-operations.sqlite3"
    ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )

    class ObservingTransport:
        def request(
            self,
            method: str,
            url: str,
            payload: dict[str, object] | None,
            timeout_seconds: float,
        ) -> OllamaHTTPResponse:
            del method, timeout_seconds
            with sqlite3.connect(database) as connection:
                row = connection.execute(
                    "SELECT outcome, operation_type FROM remote_operations"
                ).fetchone()
            assert row == ("pending", "inspect")
            if url.endswith("/api/version"):
                return _response({"version": "0.5.4"})
            assert url.endswith("/api/show")
            assert payload is not None
            assert "operation_id" not in payload
            return _response({"model_info": {"general.architecture": "test"}})

    backend = _backend(ObservingTransport(), ledger=ledger)
    backend.load(OLLAMA_MANAGER_MODEL_ID)

    records = ledger.records()
    assert len(records) == 1
    assert records[0].outcome is RemoteOperationOutcome.TERMINAL_VALID
    assert ledger.active_operation_count == 0
    ledger.close()


def test_backend_storage_failure_prevents_transport_send(tmp_path) -> None:
    database = tmp_path / "remote-operations.sqlite3"
    ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )
    connection = sqlite3.connect(database)
    connection.execute(
        "CREATE TRIGGER reject_dispatch BEFORE UPDATE ON remote_operations "
        "WHEN NEW.outcome = 'pending' BEGIN "
        "SELECT RAISE(ABORT, 'PRIVATE_SQLITE_FAILURE'); END"
    )
    connection.commit()
    connection.close()
    transport = FakeOllamaTransport([])
    backend = _backend(transport, ledger=ledger)

    with pytest.raises(OllamaBackendError) as error:
        backend.load(OLLAMA_MANAGER_MODEL_ID)

    assert "PRIVATE_SQLITE_FAILURE" not in str(error.value)
    assert transport.calls == []
    assert ledger.active_operation_count == 1
    assert ledger.records()[0].outcome is RemoteOperationOutcome.RESERVED
    ledger.close()


def test_backend_does_not_return_result_when_terminal_commit_fails(tmp_path) -> None:
    database = tmp_path / "remote-operations.sqlite3"
    ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )
    connection = sqlite3.connect(database)
    connection.execute(
        "CREATE TRIGGER reject_terminal BEFORE UPDATE ON remote_operations "
        "WHEN NEW.outcome = 'terminal_valid' BEGIN "
        "SELECT RAISE(ABORT, 'PRIVATE_SQLITE_FAILURE'); END"
    )
    connection.commit()
    connection.close()
    transport = FakeOllamaTransport(
        [_response({"model_info": {"general.architecture": "test"}})]
    )
    backend = _backend(transport, ledger=ledger)

    with pytest.raises(OllamaBackendError) as error:
        backend.load(OLLAMA_MANAGER_MODEL_ID)

    assert "PRIVATE_SQLITE_FAILURE" not in str(error.value)
    assert len(transport.calls) == 2
    assert ledger.records()[0].outcome is RemoteOperationOutcome.UNCERTAIN
    assert ledger.active_operation_count == 1
    ledger.close()


def test_backend_enforces_capacity_across_sqlite_connections(tmp_path) -> None:
    database = tmp_path / "remote-operations.sqlite3"
    first_ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )
    second_ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )
    request_started = Event()
    release_request = Event()
    first_errors: list[BaseException] = []

    class BlockingTransport:
        def request(
            self,
            method: str,
            url: str,
            payload: dict[str, object] | None,
            timeout_seconds: float,
        ) -> OllamaHTTPResponse:
            del method, payload, timeout_seconds
            if url.endswith("/api/version"):
                return _response({"version": "0.5.4"})
            request_started.set()
            if not release_request.wait(timeout=3):
                raise TimeoutError("test transport release expired")
            return _response({"model_info": {"general.architecture": "test"}})

    first_transport = BlockingTransport()
    second_transport = FakeOllamaTransport(
        [_response({"model_info": {"general.architecture": "test"}})]
    )
    first_backend = _backend(first_transport, ledger=first_ledger)
    second_backend = _backend(second_transport, ledger=second_ledger)

    def first_load() -> None:
        try:
            first_backend.load(OLLAMA_MANAGER_MODEL_ID)
        except BaseException as error:
            first_errors.append(error)

    worker = Thread(target=first_load)
    worker.start()
    try:
        assert request_started.wait(timeout=3)
        with pytest.raises(OllamaBackendError, match="capacity"):
            second_backend.load(OLLAMA_MANAGER_MODEL_ID)
        assert second_transport.calls == []
    finally:
        release_request.set()
        worker.join(timeout=3)
    assert not worker.is_alive()
    assert first_errors == []
    first_ledger.close()
    second_ledger.close()


def test_pre_dispatch_failure_releases_only_its_ledger_record(
    monkeypatch,
    tmp_path,
) -> None:
    import jarvis.ai.ollama as ollama_module

    database = tmp_path / "remote-operations.sqlite3"
    ledger = RemoteOperationLedger(
        max_concurrent_operations=1,
        sqlite_path=database,
    )

    def fail_request_construction(*args, **kwargs):
        del args, kwargs
        raise ValueError("PRIVATE_PREPARATION_MARKER")

    monkeypatch.setattr(ollama_module, "Request", fail_request_construction)
    backend = _backend(_UrllibOllamaTransport(), ledger=ledger)

    with pytest.raises(OllamaBackendError) as error:
        backend.load(OLLAMA_MANAGER_MODEL_ID)

    record = ledger.records()[0]
    assert error.value.classification is OllamaOperationClassification.NOT_SENT
    assert record.outcome is RemoteOperationOutcome.NOT_SENT
    assert ledger.active_operation_count == 0
    assert "PRIVATE_PREPARATION_MARKER" not in str(error.value)
    ledger.close()


