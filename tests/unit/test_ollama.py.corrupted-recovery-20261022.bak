    assert [call[1].rsplit("/", 1)[-1] for call in incompatible_transport.calls] == [
        "version"
    ]


def test_ollama_backend_reverifies_identity_before_inference() -> None:
    settings = _settings()
    dependencies = _strict_backend_kwargs(settings)
    catalog = dependencies["model_catalog"]
    entry = catalog.entries[0]
    changed_identity = ArtifactIdentity(
        runtime=entry.identity.runtime,
        artifact_id=entry.identity.artifact_id,
        variant=entry.identity.variant,
        quantization=entry.identity.quantization,
        digest="sha256:" + "b" * 64,
    )
    dependencies["model_catalog"] = ModelCatalog(
        (entry,),
        identity_verifier=ChangingIdentityVerifier(
            entry.identity,
            changed_identity,
        ),
    )
    transport = FakeOllamaTransport(
        [_response({"model_info": {"general.architecture": "test"}})]
    )
    ledger = _temporary_ledger(max_concurrent_operations=1)
    backend = _SyntheticTestOllamaBackend(
        settings=settings,
        transport=transport,
        ledger=ledger,
        **dependencies,
    )
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError, match="did not complete reliably"):
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "Pregunta",
            context_tokens=8,
            max_context_tokens=128,
        )

    assert [call[1].rsplit("/", 1)[-1] for call in transport.calls] == [
        "version",
        "show",
        "version",
    ]
    assert ledger.records()[-1].outcome is RemoteOperationOutcome.UNCERTAIN


def test_backend_blocks_generation_without_authenticated_artifact_identity() -> None:
    settings = _settings()
