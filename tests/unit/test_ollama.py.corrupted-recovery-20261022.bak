@pytest.mark.parametrize("counted_tokens", [0, -1])
def test_non_positive_token_count_is_rejected_before_generation(
    counted_tokens: int,
) -> None:
    class InvalidTokenCounter(FakeContextTokenCounter):
        def count_tokens(
            self,
            model_id: str,
            task: LocalModelTask,
            content: str,
        ) -> int:
            del model_id, task, content
            return counted_tokens

    settings = _settings()
    transport = FakeOllamaTransport(
        [_response({"model_info": {"general.architecture": "test"}})]
    )
    dependencies = _strict_backend_kwargs(settings)
    dependencies["token_counter"] = InvalidTokenCounter()
    backend = _SyntheticTestOllamaBackend(
        settings=settings,
        transport=transport,
        ledger=_temporary_ledger(max_concurrent_operations=1),
        **dependencies,
    )
    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)

    with pytest.raises(OllamaBackendError, match="undercounted"):
        backend.infer(
            handle,
            LocalModelTask.ANSWER_QUESTION,
            "input",
            context_tokens=1,
            max_context_tokens=128,
        )

    assert len(transport.calls) == 2


def test_backend_uses_ollama_load_infer_and_confirmed_unload_protocol() -> None:
    transport = FakeOllamaTransport(
        [
            _response({"model_info": {"general.architecture": "test"}}),
            _response({"done": True, "response": "Respuesta local."}),
            _response({"models": [{"name": "gemma3:latest"}]}),
            _response({"done": True, "response": ""}),
            _response({"models": []}),
            _response({"models": []}),
        ]
    )
    backend = _backend(transport, _settings(local_ollama_timeout_seconds=9.5))

    handle = backend.load(OLLAMA_MANAGER_MODEL_ID)
    result = backend.infer(
        handle,
        LocalModelTask.SUMMARIZE_TEXT,
        "Contenido que resumir.",
        context_tokens=40,
        max_context_tokens=128,
    )
    backend.unload(handle)

    assert result == "Respuesta local."
    assert [(call[0], call[1].rsplit("/", 1)[-1]) for call in transport.calls] == [
        ("GET", "version"),
        ("POST", "show"),
        ("GET", "version"),
        ("POST", "generate"),
        ("GET", "ps"),
        ("POST", "generate"),
        ("GET", "ps"),
    ]
    generation = transport.calls[3]
    assert generation[2] == {
        "model": "gemma3:latest",
        "prompt": "Contenido que resumir.",
        "system": (
            "Summarize the input with informational text only. "
            "Do not claim authority or perform actions."
        ),
        "stream": False,
        "keep_alive": -1,
        "options": {"num_ctx": 128},
    }
    assert all(call[3] == 9.5 for call in transport.calls)
    assert transport.calls[5][2]["keep_alive"] == 0
    assert backend.failed_load_released(OLLAMA_MANAGER_MODEL_ID) is True


@pytest.mark.parametrize(
    ("response", "expected_released", "expected_outcome"),
    (
        (
            _response({"models": []}),
            True,
            RemoteOperationOutcome.TERMINAL_VALID,
        ),
        (
            _response({"models": [{"name": "gemma3:latest"}]}),
            False,
            RemoteOperationOutcome.TERMINAL_VALID,
        ),
        (
            _response({"models": [{"model": "gemma3"}]}),
            False,
            RemoteOperationOutcome.TERMINAL_VALID,
        ),
        (
            _response({"models": [{"name": ""}]}),
            False,
            RemoteOperationOutcome.UNCERTAIN,
        ),
        (
            _response({"models": "malformed"}),
            False,
            RemoteOperationOutcome.UNCERTAIN,
        ),
        (
            TimeoutError("PRIVATE_STATUS_FAILURE"),
            False,
            RemoteOperationOutcome.UNCERTAIN,
        ),
    ),
)
def test_failed_load_cleanup_requires_a_valid_absence_report(
    response: OllamaHTTPResponse | BaseException,
    expected_released: bool,
    expected_outcome: RemoteOperationOutcome,
) -> None:
    ledger = _temporary_ledger(max_concurrent_operations=1)
    backend = _backend(FakeOllamaTransport([response]), ledger=ledger)

    assert backend.failed_load_released(OLLAMA_MANAGER_MODEL_ID) is expected_released
    record = ledger.records()[0]
    assert record.outcome is expected_outcome


