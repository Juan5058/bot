def test_conversation_result_rejects_success_with_error() -> None:
    result = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=None,
        authorized=True,
        success=True,
        error="Request was denied.",
    )

    with pytest.raises(ValueError, match="cannot contain an error"):
        result.to_dict()


def test_conversation_result_rejects_failure_with_successful_tool_result() -> None:
    result = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=None,
        authorized=True,
        success=False,
        tool_result={
            "tool_name": "echo_message",
            "status": "simulated_ok",
            "result": {
                "kind": "simulated_echo",
                "message": "hello",
                "status": "ok",
                "execution_mode": "simulated",
            },
        },
    )

    with pytest.raises(ValueError, match="Failed conversation results"):
        result.to_dict()


def test_conversation_result_rejects_successful_proposal_without_result() -> None:
    result = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=ToolProposal(tool_name="echo_message"),
        authorized=True,
        success=True,
    )

    with pytest.raises(ValueError, match="must include an execution result"):
        result.to_dict()


def test_conversation_result_allows_success_without_tool_proposal() -> None:
    result = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=None,
        authorized=False,
        success=True,
    )

    serialized = result.to_dict()

    assert serialized["success"] is True
    assert serialized["tool_result"] is None
    assert serialized["error"] is None


def test_public_result_rejects_unknown_tool_output_without_echoing_it() -> None:
    marker = "possible-secret-result-marker"
    result = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=None,
        authorized=True,
        success=True,
        tool_result={
            "tool_name": "echo_message",
            "status": "simulated_ok",
            "result": {"secret": marker},
        },
    )

    with pytest.raises(ValueError) as error:
        result.to_dict()

    assert marker not in str(error.value)


@pytest.mark.parametrize(
    ("field", "value", "error"),
    (
        ("tool_name", object(), TypeError),
        ("parameters", {"unsupported": object()}, TypeError),
        ("parameters", {1: "invalid-key"}, TypeError),
        ("parameters", {"number": float("inf")}, ValueError),
    ),
)
def test_conversation_result_rejects_invalid_proposal_values(field, value, error) -> None:
    proposal = ToolProposal(tool_name="echo_message")
    setattr(proposal, field, value)
    result = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=proposal,
        authorized=False,
        success=False,
    )
    with pytest.raises(error):
        result.to_dict()


def test_conversation_result_parameter_depth_limit() -> None:
    within_limit = "value"
    for _ in range(31):
        within_limit = [within_limit]

    accepted = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=ToolProposal(
            tool_name="echo_message",
            parameters={"nested": within_limit},
        ),
        authorized=False,
        success=False,
    )
    assert "proposal" not in accepted.to_dict()

    exceeds_limit = "value"
    for _ in range(32):
        exceeds_limit = [exceeds_limit]

    rejected = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=ToolProposal(
            tool_name="echo_message",
            parameters={"nested": exceeds_limit},
        ),
        authorized=False,
        success=False,
    )
    with pytest.raises(ValueError, match="nesting depth"):
        rejected.to_dict()


def test_conversation_result_parameter_container_item_limit() -> None:
    accepted_list = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=ToolProposal(
            tool_name="echo_message",
            parameters={"items": list(range(256))},
        ),
        authorized=False,
        success=False,
    )
    assert "proposal" not in accepted_list.to_dict()

    rejected_list = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=ToolProposal(
            tool_name="echo_message",
            parameters={"items": list(range(257))},
        ),
        authorized=False,
        success=False,
    )
    with pytest.raises(ValueError, match="containers"):
        rejected_list.to_dict()

    accepted_dict = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=ToolProposal(
            tool_name="echo_message",
            parameters={f"item_{index}": index for index in range(256)},
        ),
        authorized=False,
        success=False,
    )
    assert "proposal" not in accepted_dict.to_dict()

    rejected_dict = ConversationResult(
        user_text="hello",
        intent="text_request",
        proposal=ToolProposal(
            tool_name="echo_message",
            parameters={f"item_{index}": index for index in range(257)},
        ),
        authorized=False,
        success=False,
    )
    with pytest.raises(ValueError, match="containers"):
        rejected_dict.to_dict()


def test_conversation_result_parameter_global_node_limit() -> None:
    parameters = {
