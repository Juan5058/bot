        intent="text_request",
        proposal=ToolProposal(
            tool_name="echo_message",
            parameters=parameters,
        ),
        authorized=False,
        success=False,
    )

    with pytest.raises(ValueError, match="supported size"):
        result.to_dict()


def test_conversation_result_rejects_cyclic_parameters_without_recursion_error() -> None:
